[Unit]
Description=Nathaya Xray loopback inbounds
After=network.target

[Service]
Type=simple
DynamicUser=yes
LoadCredential=config:/etc/nathaya-tunnel/managed-stack/xray.json
ExecStart=/usr/bin/env /opt/nathaya/bin/xray run -config %d/config
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
LimitCORE=0

[Install]
WantedBy=multi-user.target
