[Unit]
Description=Nathaya WS and WSS frontend
After=network.target nathaya-ws.service
Requires=nathaya-ws.service

[Service]
Type=notify
ExecStart=/usr/sbin/haproxy -Ws -f /etc/nathaya-tunnel/managed-ws/haproxy.cfg
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
LimitCORE=0

[Install]
WantedBy=multi-user.target
