[Unit]
Description=Nathaya authenticated HTTPS CONNECT for SSH only
After=network.target nathaya-dropbear.service
ConditionPathExists=/etc/nathaya-tunnel/connect.key

[Service]
Type=notify
DynamicUser=yes
LoadCredential=relay:/etc/nathaya-tunnel/managed-ws/relay.key
LoadCredential=domain:/etc/nathaya-tunnel/managed-ws/domain
LoadCredential=proxy_auth:/etc/nathaya-tunnel/connect.key
LoadCredential=certificate:/etc/nathaya-tunnel/tls/fullchain.pem
LoadCredential=private_key:/etc/nathaya-tunnel/tls/privkey.pem
ExecStart=/usr/bin/python3 -I /opt/nathaya/modules/ssh/connect_gateway.py
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LimitCORE=0

[Install]
WantedBy=multi-user.target
