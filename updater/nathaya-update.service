[Unit]
Description=Nathaya Tunnel opt-in stable code update
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/nathaya/updater-state/auto.json

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/bin/sh /opt/nathaya/updater/update.sh auto
TimeoutStartSec=10min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/nathaya /run
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
