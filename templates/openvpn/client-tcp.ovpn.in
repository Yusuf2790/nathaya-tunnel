# Adapted from Alrescha79 setup.sh:835-909; MIT attribution in NOTICE.
auth-user-pass
client
dev tun
proto tcp
remote @HOST@ 1194
persist-key
persist-tun
pull
resolv-retry infinite
nobind
user nobody
comp-lzo
remote-cert-tls server
verb 3
mute 2
connect-retry 5 5
connect-retry-max 8080
mute-replay-warnings
redirect-gateway def1
script-security 2
cipher none
auth none
