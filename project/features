setting_reboot_jam_reboot() {
  clear
  echo -e "${orange}╔═══════════════════════════════════════════════════════════════════════╗${neutral}"
  echo -e "${green}║                         PENGATURAN AUTO REBOOT VPS                    ║${neutral}"
  echo -e "${orange}╚═══════════════════════════════════════════════════════════════════════╝${neutral}"

  local status="Tidak Aktif"
  local curr_hour="--"
  if [[ -f /etc/cron.d/daily_reboot ]]; then
      curr_hour=$(grep -E '/sbin/reboot' /etc/cron.d/daily_reboot 2>/dev/null | awk '{print $2}')
      if [[ -n $curr_hour ]]; then
          status="Aktif (Setiap hari jam ${curr_hour}:00)"
      fi
  fi

  echo -e "  ${yellow}Status Saat Ini : ${neutral}$status"
  if [[ $status != "Tidak Aktif" ]]; then
      echo -e "  File Cron      : ${neutral}/etc/cron.d/daily_reboot"
  fi
  echo -e "${orange}╔═══════════════════════════════════════════════════════════════════════╗${neutral}"
  echo -e "  Opsi:"
  echo -e "   ${green}1.${neutral} Ubah / Setel Jadwal Reboot Harian"
  echo -e "   ${green}2.${neutral} Nonaktifkan Auto Reboot"
  echo -e "   ${green}x.${neutral} Kembali"
  echo -e "${orange}╚═══════════════════════════════════════════════════════════════════════╝${neutral}"
  read -p "  Pilih opsi [1/2/x]: " opt
  case $opt in
      1)
          read -p "  Masukkan jam (00-23) reboot harian: " reboot_hour
          if [[ -z "$reboot_hour" || ! "$reboot_hour" =~ ^[0-9]{2}$ || $reboot_hour -lt 0 || $reboot_hour -gt 23 ]]; then
              echo -e "  ${red}Input jam tidak valid.${neutral}"
              read -n1 -s -p "  Tekan tombol untuk kembali"; return
          fi
          if [[ -f /etc/cron.d/daily_reboot ]]; then
              read -p "  Jadwal sudah ada (${curr_hour}:00). Ganti ke ${reboot_hour}:00 ? (y/n): " konfirm
              [[ ! $konfirm =~ ^[Yy]$ ]] && echo -e "  ${yellow}Dibatalkan, tidak ada perubahan.${neutral}" && sleep 1 && return
          else
              read -p "  Terapkan auto reboot jam ${reboot_hour}:00 ? (y/n): " konfirm
              [[ ! $konfirm =~ ^[Yy]$ ]] && echo -e "  ${yellow}Dibatalkan.${neutral}" && sleep 1 && return
          fi
          nathaya_cron set /etc/cron.d/daily_reboot <<EOF || return 1
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
0 $reboot_hour * * * root /sbin/reboot
EOF
          systemctl restart cron 2>/dev/null || return 1
          echo -e "\n  ${green}Auto Reboot diset setiap hari jam ${reboot_hour}:00${neutral}"
          ;;
      2)
          if [[ ! -f /etc/cron.d/daily_reboot ]]; then
              nathaya_cron remove /etc/cron.d/daily_reboot || return 1
              echo -e "  ${yellow}Auto Reboot sudah tidak aktif.${neutral}"
          else
              read -p "  Nonaktifkan auto reboot? (y/n): " ans
              if [[ $ans =~ ^[Yy]$ ]]; then
                  nathaya_cron remove /etc/cron.d/daily_reboot || return 1
                  systemctl restart cron 2>/dev/null || return 1
                  echo -e "  ${green}Auto Reboot dinonaktifkan.${neutral}"
              else
                  echo -e "  ${yellow}Dibatalkan.${neutral}"
              fi
          fi
          ;;
      x|X)
          return ;;
      *)
          echo -e "  ${red}Pilihan tidak dikenal.${neutral}" ;;
  esac
  echo -e "${orange}═══════════════════════════════════════════════════════════════════════${neutral}"
  read -n1 -s -p "  Tekan tombol untuk kembali ke menu utama"
}

