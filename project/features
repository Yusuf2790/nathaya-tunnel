        features_header 'PENGATURAN SISTEM & FITUR'
        echo -e "${orange}╠═══════════════════════════════════════════════════════════════════════╣${neutral}"
        echo -e "${orange}╠═══════════════════════════════════════════════════════════════════════╣${neutral}"
            echo -e "${neutral}${green} [1]${neutral} Periksa Sistem Berjalan    ║${neutral} ${green} [9]${neutral}  Panduan Dropbear"
            echo -e "${neutral}${green} [2]${neutral} Periksa Penggunaan BW      ║${neutral}  ${green}[10]${neutral} Perbarui Versi X-ray"
        echo -e "${neutral}${green} [3]${neutral} Cadangan Otomatis Server   ║${neutral}  ${green}[11]${neutral} Gotop (Monitor Sistem)"
