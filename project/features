setup_bot_telegram() (
    set +x
    [[ $EUID -eq 0 ]] || { echo 'Administrator privileges required.' >&2; return 1; }
    umask 077
    local token chat temporary
    features_header 'SETUP TELEGRAM — ADMIN ONLY'
    printf 'Konfigurasi lama tidak ditampilkan. Tidak ada pesan uji yang dikirim.\n'
    read -r -s -p 'Bot token: ' token || return 1
    printf '\n'
    read -r -s -p 'Chat ID: ' chat || return 1
    printf '\n'
    [[ $token =~ ^[0-9]{6,}:[A-Za-z0-9_-]{20,}$ && $chat =~ ^-?[0-9]+$ ]] || {
        echo 'Format token atau chat ID tidak valid.' >&2; return 1;
    }
    [[ ! -L /root/.vars && ( ! -e /root/.vars || -f /root/.vars ) ]] || {
        echo 'Refusing an unsafe configuration target.' >&2; return 1;
    }
    temporary=$(mktemp /root/.vars.XXXXXX) || return 1
    trap 'rm -f -- "$temporary"' EXIT
    # Validated alphabet contains no shell metacharacters; compatible with
    # upstream Bash consumers and the non-evaluating expiry reader.
    printf 'bot_token="%s"\ntelegram_id="%s"\n' "$token" "$chat" > "$temporary" || return 1
    chown root:root "$temporary" && chmod 600 "$temporary" && mv -fT -- "$temporary" /root/.vars || return 1
    unset token chat
    printf 'Konfigurasi disimpan privat di /root/.vars (0600).\n'
    systemctl try-restart limitip.service >/dev/null 2>&1 || {
        echo 'Konfigurasi tersimpan; periksa service limitip secara manual.' >&2; return 1;
    }
)

backup_local_menu() {
    local choice location
    features_header 'BACKUP / RESTORE — LOCAL ONLY'
    printf '  1. Backup ke arsip lokal\n  2. Restore arsip lokal\n  3. UI web privat (SSH forward)\n  x. Kembali\n'
    read -r -p 'Pilih: ' choice || return
    case "$choice" in
        1) read -r -p 'Path arsip baru /root/PRIVATE/nama.tar.gz: ' location || return
           backuprestore backup "$location" ;;
        2) read -r -p 'Path arsip privat untuk restore: ' location || return
           backuprestore restore "$location" ;;
        3) read -r -p 'Direktori arsip privat di bawah /root: ' location || return
           backuprestore server "$location" ;;
        x|X) return ;;
        *) echo 'Pilihan tidak valid.'; return 1 ;;
    esac
}

auto_backup() {
    local choice schedule directory
    features_header 'CADANGAN OTOMATIS — LOCAL ONLY'
    printf '  1. Setiap jam\n  2. Harian\n  3. Mingguan\n  4. Bulanan\n  5. Nonaktifkan\n  x. Kembali\n'
    printf 'Arsip tetap lokal; tidak dikirim ke Telegram atau web root. Pantau ruang disk.\n'
    read -r -p 'Pilih: ' choice || return
    case "$choice" in
        1) schedule='0 * * * *' ;;
        2) schedule='0 0 * * *' ;;
        3) schedule='0 0 * * 0' ;;
        4) schedule='0 0 1 * *' ;;
        5) nathaya_cron remove /etc/cron.d/backup || return 1
           systemctl restart cron || return 1; return ;;
        x|X) return ;;
        *) echo 'Pilihan tidak valid.'; return 1 ;;
    esac
    read -r -p 'Direktori privat /root/PRIVATE (wajib, tanpa spasi): ' directory || return
    # A restrictive alphabet also excludes cron %, newlines and shell syntax.
    [[ $directory =~ ^/root/[A-Za-z0-9_./-]+$ ]] || { echo 'Path tidak valid.' >&2; return 1; }
    backuprestore check-directory "$directory" || return 1
    { printf 'SHELL=/bin/bash\nPATH=/usr/sbin:/usr/bin:/sbin:/bin\n';
      printf '%s root /usr/bin/backuprestore backup-dir %s\n' "$schedule" "$directory";
    } | nathaya_cron set /etc/cron.d/backup || return 1
    systemctl restart cron || return 1
    printf 'Jadwal backup lokal disimpan. Arsip tidak dihapus otomatis.\n'
}

