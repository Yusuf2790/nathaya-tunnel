        echo -e "${neutral}${green} [7]${neutral} Ubah Domain Server"
        echo -e "${neutral}${green} [8]${neutral} Ubah Banner Server           ${green}[15]${neutral} Setup Telegram (admin)"
        echo -e "${neutral}                 ${red} [x]${neutral} Keluar dari Menu Sistem & Fitur${neutral}"
        echo -e "${orange}╚═══════════════════════════════════════════════════════════════════════╝${neutral}"
        echo -e ""
        echo -ne "   ${green}Pilih menu [1-15] atau ketik 'x' untuk keluar: ${neutral}"
        read -r menu || return
        case $menu in
            1) running ;;
            2) check_bw ;;
            3) auto_backup ;;
            4) backup_local_menu ;;
            5) info_port ;;
            6) restart_services ;;
            7) change_domain ;;
            8) edit_banner; clear ;;
            9) read -p " Lihat panduan perawatan Dropbear manual? (y/n): " ans; [[ ! $ans =~ ^[Yy]$ ]] && continue; dropbear_update ;;
            10) echo -e "${red}PERINGATAN:${neutral} Pembaruan versi Xray masih ${yellow}eksperimental${neutral}. Pastikan Anda punya backup."; read -p " Lanjutkan update Xray? (y/n): " ans; [[ ! $ans =~ ^[Yy]$ ]] && continue; xray_update ;;
            11)
                # Countdown sebelum menjalankan gotop dengan opsi batal Ctrl+C
                if ! command -v gotop >/dev/null 2>&1; then
                    echo -e "${red}gotop belum terpasang. Silakan instal terlebih dahulu.${neutral}"
                    sleep 2
                    continue
                fi
                echo -e "${orange}Menjalankan monitor sistem (gotop) dalam 5 detik...${neutral}"
                echo -e "${yellow}Tekan Ctrl+C untuk membatalkan dan kembali ke menu.${neutral}"
                cancel_flag=0
                (
                  trap 'cancel_flag=1' INT
                  for i in 5 4 3 2 1; do
                      if [ "$cancel_flag" = 1 ]; then break; fi
                      printf " Mulai dalam %s detik... (Ctrl+C untuk batal)\r" "$i"
                      sleep 1
                  done
                  echo -e ""
                  if [ "$cancel_flag" = 1 ]; then
                      echo -e "${red}Dibatalkan.${neutral}"
                      exit 99
                  fi
                  exit 0
                )
                rc=$?
                if [ $rc -eq 99 ]; then
                    # dibatalkan
                    sleep 1
                    continue
                fi
                gotop
                ;;
            12) setting_reboot_jam_reboot ;;
            13) uninstall_panel_vpn ;;
            14) read -p " Apakah Anda yakin ingin reboot server? (y/n): " ans; [[ $ans =~ ^[Yy]$ ]] && reboot ;;
            15) setup_bot_telegram ;;
            x|X)
                echo -e ""
                echo -e "${green}╔═══════════════════════════════════════════════════════════════════════╗${neutral}"
                echo -e "${green}║                    Terima kasih telah menggunakan                     ║${neutral}"
                echo -e "${green}║                       NATHAYA TUNNEL                            ║${neutral}"
                echo -e "${green}║                                                                       ║${neutral}"
                echo -e "${green}║                 Private administration — Nathaya Tunnel                  ║${neutral}"
                echo -e "${green}║                                                                       ║${neutral}"
                echo -e "${green}║            Ketik perintah ${yellow}menu${green} untuk membuka panel kembali            ║${neutral}"
                echo -e "${green}╚═══════════════════════════════════════════════════════════════════════╝${neutral}"
                return
                ;;
            *)
                echo -e "   ${red}Pilihan tidak valid!${neutral}"
                sleep 1.5
                ;;
        esac
    done
}
# One-shot sections return to the parent UI; no recursive menu/installer calls.
features_main() {
    [[ $EUID -eq 0 ]] || { echo 'Administrator privileges required.' >&2; return 1; }
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    if [[ $# -eq 0 ]]; then
        display_features
    elif [[ $# -eq 2 && $1 == --section ]]; then
        case "$2" in
            banner) edit_banner ;;
            bandwidth) check_bw ;;
            services) running ;;
            domain) change_domain ;;
            telegram) setup_bot_telegram ;;
            *) echo 'Unknown section.' >&2; return 1 ;;
        esac
    else
        echo 'Usage: features [--section banner|bandwidth|services|domain|telegram]' >&2
        return 1
    fi
}
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    NATHAYA_BASE="${NATHAYA_BASE:-/opt/nathaya}"
    if [[ ! -r "$NATHAYA_BASE/modules/common/runtime-ui.sh" ]]; then
        printf 'UI Nathaya belum terpasang di %s/modules. Perbarui instalasi.\n' "$NATHAYA_BASE" >&2
        exit 1
    fi
    # runtime-ui loads common/functions.sh before any menu action is dispatched.
    source "$NATHAYA_BASE/modules/common/runtime-ui.sh" || exit 1
    features_main "$@"
fi