#!/bin/bash

# Shared presentation and optional Telegram transport installed by Nathaya.
if [[ -r /opt/nathaya/modules/common/telegram.sh ]]; then
    source /opt/nathaya/modules/common/telegram.sh
fi
if ! declare -F nathaya_account_render >/dev/null; then
    printf '%s\n' 'Nathaya account presentation module is not installed.' >&2
    exit 1
fi
NATHAYA_ACCOUNT_ACTION=trial
NATHAYA_ACCOUNT_PROTOCOL=SHADOWSOCKS

# Report partial persistence without claiming that the trial is ready.
nathaya_trial_fail() {
    local message="$1"
    printf '%s\n' "$message" >&2
    send_telegram_notification "error" "$user" "${duration:-}" "$message"
    nathaya_account_render terminal error "$message"
    exit 1
}

# Values below are the upstream connection/display data; formatting is shared.
nathaya_account_data() {
    nathaya_account_add 'SERVER INFORMATION' 'CITY' "${city:-}"
    nathaya_account_add 'SERVER INFORMATION' 'Host' "${domain:-}"
    nathaya_account_add 'SERVER INFORMATION' 'IP' "${ip:-${IP:-Tidak diketahui}}"
    nathaya_account_add 'ACCOUNT INFORMATION' 'User' "${user:-}"
    nathaya_account_add 'ACCOUNT INFORMATION' 'Pass' "${password:-}"
    nathaya_account_add 'ACCOUNT INFORMATION' 'Expired' "${exp:-}"
    nathaya_account_add 'SERVER INFORMATION' 'Host XrayDNS' "${ns_domain:-}"
    nathaya_account_add 'CONNECTION INFORMATION' 'Port' "443"
    nathaya_account_add 'CONNECTION INFORMATION' 'Method' "${method:-}"
    nathaya_account_add 'CONNECTION INFORMATION' 'Path WS' "/whatever/shadowsocks"
    nathaya_account_add 'CONNECTION INFORMATION' 'ServiceName' "ss-grpc"
    nathaya_account_add 'CONNECTION INFORMATION' 'Public Key' "${pubkey:-}"
    nathaya_account_add 'CONNECTION LINKS' 'SS WS Link' "${ss_link_ws:-}"
    nathaya_account_add 'CONNECTION LINKS' 'SS gRPC Link' "${ss_link_grpc:-}"
    nathaya_account_add 'CONNECTION LINKS' 'OpenClash Format' "https://${domain:-}:81/shadowsocks-${user:-}.txt"
}

# Valid Script
ipsaya=$(curl -sS ipv4.icanhazip.com)
data_server=$(curl -v --insecure --silent https://google.com/ 2>&1 | grep Date | sed -e 's/< Date: //')
date_list=$(date +"%Y-%m-%d" -d "$data_server")


    

# Colors
red=$'\033[1;31m'
green=$'\033[1;32m'
yellow=$'\033[38;5;208m'
blue=$'\033[1;36m'
purple=$'\033[1;36m'
cyan=$'\033[1;36m'
white=$'\033[1;37m'
reset=$'\033[0m'
# Function to print rainbow text
print_rainbow() {
    if [[ -t 1 ]]; then printf '\033[1;36m'; fi
    printf '%s\n' "$1"
    if [[ -t 1 ]]; then printf '\033[0m'; fi
}

# Function to send Telegram notification

# Variables
ip=$(wget -qO- ipv4.icanhazip.com)
srv_date=$(curl -v --insecure --silent https://google.com/ 2>&1 | grep Date | sed -e 's/< Date: //')
date=$(date +"%Y-%m-%d" -d "$srv_date")
ip_url="https://ip.yha.my.id/ip"
city=$(cat /etc/xray/city 2>/dev/null || echo "Unknown city")
pubkey=$(cat /etc/slowdns/server.pub 2>/dev/null || echo "Pubkey not available")
ns_domain=$(cat /etc/xray/dns 2>/dev/null || echo "NS domain not set")
domain=$(cat /etc/xray/domain 2>/dev/null || hostname -f)

# Loading animation
echo ""
echo -ne "${yellow}Preparing Premium Account${reset}"
for i in {1..2}; do
    for j in ⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏; do
        echo -ne "\r${yellow}Preparing Premium Account $j${reset}"
        sleep 0.1
    done
done
echo -ne "\r${yellow}Premium Account Ready to be created!${reset}\n"
sleep 1
clear

# User data input
nathaya_account_header "TRIAL SHADOWSOCKS"

# Generate random username
user=$(cat /dev/urandom | tr -dc 'a-zA-Z0-9' | fold -w 8 | head -n 1)
nathaya_account_require_username "$user" || exit 1

echo "   Username : $user"
until [[ "$duration" =~ ^[0-9]+$ && "$duration" =~ [1-9] ]]; do
    read -r -p "   Active period (minutes): " duration || exit 1
    if [[ ! "$duration" =~ ^[0-9]+$ || ! "$duration" =~ [1-9] ]]; then
        echo -e "${red}   Active period must be a positive number of minutes${reset}"
    fi
done
exp=$(date -d "+$duration minutes" +"%Y-%m-%d %H:%M:%S") ||
    nathaya_trial_fail 'Invalid trial expiry; no account changes were requested.'
if ! grep -qx '#ssws' /etc/xray/shadowsocks/config.json ||
    ! grep -qx '#ssgrpc' /etc/xray/shadowsocks/config.json; then
    nathaya_trial_fail 'Shadowsocks transport markers are missing; no account changes were requested.'
fi
method="aes-256-gcm"
password=$(cat /proc/sys/kernel/random/uuid) ||
    nathaya_trial_fail 'Failed to generate a trial credential; no account changes were requested.'
[[ -n "$password" ]] || nathaya_trial_fail 'Empty trial credential; no account changes were requested.'
# One credential for server clients, links and both exported configurations.
uuid=$password

# Add user to configuration file
if ! sed -i '/#ssws$/a\### '"$user $exp"'\
},{"password": "'""$password""'","method": "'""$method""'","email": "'""$user""'"' /etc/xray/shadowsocks/config.json; then
    nathaya_trial_fail 'Failed to write trial WS configuration. Earlier account changes may already be persisted; check account state before retrying.'
fi
if ! sed -i '/#ssgrpc$/a\### '"$user $exp"'\
},{"password": "'""$password""'","method": "'""$method""'","email": "'""$user""'"' /etc/xray/shadowsocks/config.json; then
    nathaya_trial_fail 'Failed to write trial gRPC configuration. Earlier account changes may already be persisted; check account state before retrying.'
fi

# Generate Shadowsocks links
ss_base64=$(echo -n "${method}:${password}" | base64 -w 0)
ss_link_ws="ss://${ss_base64}@${domain}:443?plugin=xray-plugin;mux=0;path=/shadowsocks;host=${domain};tls;network=ws;host=$domain#${user}-WS"
ss_link_grpc="ss://${ss_base64}@${domain}:443?plugin=xray-plugin;mux=0;serviceName=ss-grpc;host=${domain};tls#${user}-gRPC"

# Create JSON configuration file
if ! cat >/var/www/html/shadowsocks-$user.txt <<-END
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Shadowsocks WS Format
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

{
 "dns": {
    "servers": [
      "8.8.8.8",
      "8.8.4.4"
    ]
  },
 "inbounds": [
   {
      "port": 10808,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true,
        "userLevel": 8
      },
      "sniffing": {
        "destOverride": [
          "http",
          "tls"
        ],
        "enabled": true
      },
      "tag": "socks"
    },
    {
      "port": 10809,
      "protocol": "http",
      "settings": {
        "userLevel": 8
      },
      "tag": "http"
    }
  ],
  "log": {
    "loglevel": "none"
  },
  "outbounds": [
    {
      "mux": {
        "enabled": true
      },
      "protocol": "shadowsocks",
      "settings": {
        "servers": [
          {
            "address": "$domain",
            "level": 8,
            "method": "$method",
            "password": "$uuid",
            "port": 443
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "tls",
        "tlsSettings": {
          "allowInsecure": true,
          "serverName": "$domain"
        },
        "wsSettings": {
          "headers": {
            "Host": "$domain"
          },
          "path": "/whatever/shadowsocks"
        }
      },
      "tag": "proxy"
    },
    {
      "protocol": "freedom",
      "settings": {},
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "settings": {
        "response": {
          "type": "http"
        }
      },
      "tag": "block"
    }
  ],
  "policy": {
    "levels": {
      "8": {
        "connIdle": 300,
