then
    nathaya_trial_fail 'Failed to write trial export. Account changes may already be persisted; check account state before retrying.'
fi

# Restart service
if ! systemctl restart shadowsocks@config > /dev/null 2>&1; then
    nathaya_trial_fail 'Failed to restart Shadowsocks. Account changes may already be persisted; the service did not restart successfully.'
fi

# Start trial session and send success notification
if ! tmux new-session -d -s "trial_shadowsocks_$user" "trial trialss $user $duration"; then
    nathaya_trial_fail 'Failed to schedule trial expiry. Account changes may already be persisted and active; expiry scheduling is not confirmed.'
fi
send_telegram_notification "success" "$user" "$duration"

clear
nathaya_account_render terminal
